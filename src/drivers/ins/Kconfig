    menuconfig COMMON_INS
        bool "All INS sensors"
        default n
        imply DRIVERS_INS_VECTORNAV
        imply DRIVERS_INS_ILABS
        imply DRIVERS_INS_MICROSTRAIN
        imply DRIVERS_INS_EULERNAV_BAHRS
        imply DRIVERS_INS_SBGECOM
        ---help---
            Enable default set of INS sensors
    rsource "*/Kconfig"
endmenu
