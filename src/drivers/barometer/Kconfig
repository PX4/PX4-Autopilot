menu "barometer"
    menuconfig COMMON_BAROMETERS
        bool "Common barometers"
        default n
        imply DRIVERS_BAROMETER_BMP280
        imply DRIVERS_BAROMETER_BMP388
        imply DRIVERS_BAROMETER_BMP581
        imply DRIVERS_BAROMETER_DPS310
        imply DRIVERS_BAROMETER_LPS22HB
        imply DRIVERS_BAROMETER_LPS33HW
        imply DRIVERS_BAROMETER_MS5611
        imply DRIVERS_BAROMETER_MAIERTEK_MPC2520
        imply DRIVERS_BAROMETER_GOERTEK_SPL06
        imply DRIVERS_BAROMETER_GOERTEK_SPA06
        imply DRIVERS_BAROMETER_INVENSENSE_ICP101XX
        imply DRIVERS_BAROMETER_INVENSENSE_ICP201XX
        ---help---
            Enable default set of barometer drivers
    rsource "*/Kconfig"
endmenu #barometer
