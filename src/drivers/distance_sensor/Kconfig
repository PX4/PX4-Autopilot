menu "Distance sensors"
    menuconfig COMMON_DISTANCE_SENSOR
        bool "Common distance sensor's"
        default n
        imply DRIVERS_DISTANCE_SENSOR_LIGHTWARE_LASER_I2C
        imply DRIVERS_DISTANCE_SENSOR_LIGHTWARE_LASER_SERIAL
        imply DRIVERS_DISTANCE_SENSOR_LL40LS
        imply DRIVERS_DISTANCE_SENSOR_TF02PRO
        imply DRIVERS_DISTANCE_SENSOR_TFMINI
        imply DRIVERS_DISTANCE_SENSOR_ULANDING_RADAR
        imply DRIVERS_DISTANCE_SENSOR_VL53L0X
        imply DRIVERS_DISTANCE_SENSOR_VL53L1X
        ---help---
            Enable default set of distance sensor drivers

    rsource "*/Kconfig"
endmenu
