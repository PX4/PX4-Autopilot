menu "RC"
    menuconfig COMMON_RC
        bool "Common RC"
        default n
        imply DRIVERS_RC_CRSF_RC
        imply DRIVERS_RC_DSM_RC
        imply DRIVERS_RC_GHST_RC
        imply DRIVERS_RC_SBUS_RC
        ---help---
            Enable default set of radio control drivers
    rsource "*/Kconfig"
endmenu
