menuconfig SYSTEMCMDS_SERIAL_AUTOSTART
	bool "serial_autostart"
	default y
	depends on BOARD_ROMFSROOT != ""
	---help---
		Walk SER_*_PROTO / SER_*_BAUD and start the matching serial drivers.

menuconfig USER_SERIAL_AUTOSTART
	bool "serial_autostart running as userspace module"
	default y
	depends on BOARD_PROTECTED && SYSTEMCMDS_SERIAL_AUTOSTART
	---help---
		Put serial_autostart in userspace memory
