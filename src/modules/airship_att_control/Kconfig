config PACKAGE_AIRSHIP
	bool "Airship package"
	imply MODULES_AIRSHIP_ATT_CONTROL
	imply MODULES_CONTROL_ALLOCATOR
	imply MODULES_LAND_DETECTOR
	---help---
		Modules rc.airship_apps starts unconditionally.

		Modules are implied: each one defaults to enabled and can
		still be disabled individually with CONFIG_MODULES_<NAME>=n.

menuconfig MODULES_AIRSHIP_ATT_CONTROL
	bool "airship_att_control"
	default n
	---help---
		Enable support for airship_att_control

menuconfig USER_AIRSHIP_ATT_CONTROL
	bool "airship_att_control running as userspace module"
	default y
	depends on BOARD_PROTECTED && MODULES_AIRSHIP_ATT_CONTROL
	---help---
		Put airship_att_control in userspace memory
