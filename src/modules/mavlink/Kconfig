menuconfig MODULES_MAVLINK
	bool "mavlink"
	default n
	---help---
		Enable support for mavlink

menuconfig MAVLINK_DIALECT
depends on MODULES_MAVLINK
        string "Mavlink dialect"
        default "common"
	---help---
		Select the Mavlink dialect to generate and use.

menuconfig MAVLINK_EXTENSION_EXAMPLE
depends on MODULES_MAVLINK
	bool "Example MAVLink extension"
	default n
	---help---
		Build the example of px4_add_mavlink_extension(): a handler that counts the
		MEMORY_VECT messages PX4 receives on any MAVLink instance, and a MEMORY_VECT
		stream that reports the count.

menuconfig MAVLINK_NUM_CONFIG_INSTANCES
depends on MODULES_MAVLINK
	int "Number of MAVLink instance configurations"
	default 3
	range 1 3 if BOARD_CONSTRAINED_MEMORY
	range 1 5
	---help---
		Number of MAV_x_* parameter sets. At most 6 MAVLink instances can
		run at once (4 on constrained-memory boards), and USB takes one.

menuconfig MAVLINK_UAVCAN_PARAMETERS
depends on MODULES_MAVLINK && DRIVERS_UAVCAN
        bool "Mavlink UAVCAN parameter support"
        default y
	---help---
		Expose UAVCAN parameters over Mavlink.

menuconfig USER_MAVLINK
	bool "mavlink running as userspace module"
	default y
	depends on BOARD_PROTECTED && MODULES_MAVLINK
	---help---
		Put mavlink in userspace memory
