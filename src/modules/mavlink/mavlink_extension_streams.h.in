/*
 * The MAVLink streams other modules add with px4_add_mavlink_extension(), generated by the mavlink
 * module's CMakeLists.txt. MAVLINK_EXTENSION_STREAMS(X) expands X(class, index) for each, with
 * index counting the classes from 0.
 */

#pragma once

@MAVLINK_EXTENSION_INCLUDES@
#define MAVLINK_EXTENSION_STREAMS(X)@MAVLINK_EXTENSION_LIST@
