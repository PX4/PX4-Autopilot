config PACKAGE_MULTICOPTER
	bool "Multicopter package"
	imply MODULES_CONTROL_ALLOCATOR
	imply MODULES_FLIGHT_MODE_MANAGER
	imply MODULES_LAND_DETECTOR
	imply MODULES_MC_ATT_CONTROL
	imply MODULES_MC_HOVER_THRUST_ESTIMATOR
	imply MODULES_MC_POS_CONTROL
	imply MODULES_MC_RATE_CONTROL
	---help---
		Modules rc.mc_apps starts unconditionally.

		Modules are implied: each one defaults to enabled and can
		still be disabled individually with CONFIG_MODULES_<NAME>=n.

menuconfig MODULES_MC_RATE_CONTROL
	bool "mc_rate_control"
	default n
	---help---
		Enable support for mc_rate_control

menuconfig USER_MC_RATE_CONTROL
	bool "mc_rate_control running as userspace module"
	default n
	depends on BOARD_PROTECTED && MODULES_MC_RATE_CONTROL
	---help---
		Put mc_rate_control in userspace memory
