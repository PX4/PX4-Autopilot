config PACKAGE_ROVER_DIFFERENTIAL
	bool "Differential rover package"
	imply MODULES_LAND_DETECTOR
	imply MODULES_ROVER_DIFFERENTIAL
	---help---
		Modules rc.rover_differential_apps starts unconditionally.

		Modules are implied: each one defaults to enabled and can
		still be disabled individually with CONFIG_MODULES_<NAME>=n.

menuconfig MODULES_ROVER_DIFFERENTIAL
	bool "rover_differential"
	default n
	---help---
		Enable support for differential rovers
