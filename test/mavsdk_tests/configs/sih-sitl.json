{
    "mode": "sitl",
    "model_prefix": "sihsim_",
    "mavlink_connection": "udpin://0.0.0.0:14540",
    "tests":
    [
        {
            "model": "quadx",
            "test_filter": "vision_target",
            "timeout_min": 3,
            "env": {
                "PX4_PARAM_VTE_EN": 1,
                "PX4_PARAM_VTE_POS_EN": 1,
                "PX4_PARAM_VTE_YAW_EN": 1,
                "PX4_PARAM_VTE_TASK_MASK": 1,
                "PX4_PARAM_PLD_YAW_EN": 1,
                "PX4_PARAM_PLD_SRCH_ALT": 10
            }
        },
        {
            "model": "quadx",
            "test_filter": "multicopter or offboard or offboard_attitude",
            "timeout_min": 10
        },
        {
            "model": "quadx",
            "test_filter": "offboard_attitude",
            "timeout_min": 10,
            "env": {
                "PX4_PARAM_EKF2_EN": 0,
                "PX4_PARAM_ATT_EN": 1
            }
        },
        {
            "model": "quadx",
            "test_filter": "sih_home_yaw",
            "timeout_min": 10,
            "env": {
                "PX4_HOME_YAW": "2.3562",
                "PX4_SIM_GPS_USED": "0"
            }
        },
        {
            "model": "hex",
            "test_filter": "motor_failure_injection",
            "timeout_min": 15
        },
        {
            "model": "standard_vtol",
            "test_filter": "vtol",
            "timeout_min": 10
        },
        {
            "model": "xvert",
            "test_filter": "sih_xvert_transition",
            "timeout_min": 5
        }
    ]
}
