{
    "mode": "sitl",
    "model_prefix": "sihsim_",
    "mavlink_connection": "udpin://0.0.0.0:14540",
    "tests":
    [
        {
            "model": "quadx",
            "test_filter": "[multicopter],[offboard],[offboard_attitude]",
            "timeout_min": 10
        },
        {
            "model": "quadx",
            "test_filter": "[offboard_attitude]",
            "timeout_min": 10,
            "env": {
                "PX4_PARAM_EKF2_EN": 0,
                "PX4_PARAM_ATT_EN": 1
            }
        },
        {
            "model": "quadx",
            "test_filter": "[sih_home_yaw]",
            "timeout_min": 10,
            "env": {
                "PX4_HOME_YAW": "2.3562",
                "PX4_SIM_GPS_USED": "0"
            }
        },
        {
            "model": "standard_vtol",
            "test_filter": "[vtol]",
            "timeout_min": 10
        },
        {
            "model": "xvert",
            "test_filter": "[sih_xvert_transition]",
            "timeout_min": 5
        },
        {
            "model": "airplane",
            "test_filter": "[sih_catapult_launch]",
            "timeout_min": 10,
            "env": {
                "PX4_HOME_YAW": "0.7854",
                "PX4_PARAM_RWTO_TKOFF": 0,
                "PX4_PARAM_FW_LAUN_DETCN_ON": 1,
                "PX4_PARAM_EKF2_MAG_TYPE": 6,
                "PX4_PARAM_SIH_CAT_ACC": 50.0,
                "PX4_PARAM_SIH_CAT_VEL": 15.0,
                "PX4_PARAM_SIM_GPS_ACC_MAX": 15.0
            }
        }
    ]
}
