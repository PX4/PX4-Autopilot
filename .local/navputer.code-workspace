{
    "folders": [{ "path": ".." }],
    "launch": {
        "version": "0.2.0",
        "configurations": [


		{
			"name": "Navputer",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/px4_sitl_navput/bin/px4",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/build/px4_sitl_navput/bin/",
			"environment": [
				{
					"name": "PX4_SIM_MODEL",
					"value": "navput_quadx"
				},
				{
					"name": "PX4_SIMULATOR",
					"value": "sihsim"
				}
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		}
	]
    }
}
