#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

param set-default BAT1_V_DIV 19.1
param set-default BAT2_V_DIV 19.1

param set-default BAT1_A_PER_V 0
param set-default BAT2_A_PER_V 0

# Use RAM-based dataman storage (doesn't require SD card)
# Set to 1 for RAM mode, 0 for file-based storage (requires SD card)
param set-default SYS_DM_BACKEND 1

# TBS Lucid H7 has no built-in magnetometer (external compasses can be connected via I2C)
# Set SYS_HAS_MAG to 0 to allow arming without a compass
param set-default SYS_HAS_MAG 0

# Bypass supply check (SD card requirement)
param set-default CBRK_SUPPLY_CHK 894281

# Configure EKF2 for operation without magnetometer (enable gravity fusion)
param set-default EKF2_IMU_CTRL 7
