#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# IMU rotations verified on hardware (accel gravity vector, board flat, arrow
# forward). ArduPilot's hwdef lists ROLL_180 / PITCH_180, but PX4's icm42688p
# driver already flips Y/Z to a z-down frame, so the PX4 values are those
# rotations composed with ROLL_180: NONE and YAW_180.

# Internal SPI bus ICM-42688P (SPI1), no rotation (0)
icm42688p -s -b 1 start

# Internal SPI bus ICM-42688P (SPI4), YAW_180 (4)
icm42688p -s -b 4 -R 4 start

# Internal baro SPL06 on I2C2
spl06 start -I -b 2
