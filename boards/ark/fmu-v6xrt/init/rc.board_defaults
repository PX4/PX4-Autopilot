#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

set LOGGER_BUF 128

# Mavlink ethernet (CFG 1000)
param set-default MAV_2_CONFIG 1000
param set-default MAV_2_BROADCAST 1
param set-default MAV_2_MODE 0
param set-default MAV_2_RADIO_CTL 0
param set-default MAV_2_RATE 100000
param set-default MAV_2_REMOTE_PRT 14550
param set-default MAV_2_UDP_PRT 14550

param set-default SENS_EN_INA226 1
param set-default SENS_EN_THERMAL 1

if ver hwtypecmp ARKV6XRT000
then
	# LSM6DSV80X on SPI3: its high-g channel drifts 2 mg/degC, 30x the other two IMUs
	param set-default HEATER1_SENS_ID 1572890
fi

param set-default RC_CRSF_PRT_CFG 300
param set-default RC_SBUS_PRT_CFG 0

safety_button start

if param greater -s UAVCAN_ENABLE 0
then
	ifup can0
	ifup can1
	ifup can2
fi
