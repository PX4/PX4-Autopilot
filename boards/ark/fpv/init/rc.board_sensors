#!/bin/sh
#
# ARKFPV specific board sensors init
#------------------------------------------------------------------------------

board_adc start

if ver hwtypecmp ARKFPV000
then
	# Internal SPI bus IIM-42653
	iim42653 -R 14 -s -b 1 start
fi

if ver hwtypecmp ARKFPV001
then
	# Internal SPI bus LSM6DSV32X
	lsm6dsv -R 14 -s -b 1 start
fi

# Internal magnetometer on I2C
iis2mdc -R 0 -I -b 4 start

# Internal Baro on I2C
bmp388 -I -b 2 start

# Start an external PWM generator
if param greater PCA9685_EN_BUS 0
then
	pca9685_pwm_out start -X
fi
