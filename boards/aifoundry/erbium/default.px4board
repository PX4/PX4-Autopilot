CONFIG_BOARD_TOOLCHAIN="riscv-none-elf"
CONFIG_BOARD_ARCHITECTURE="rv64imfc"
CONFIG_BOARD_NO_SDCARD=y
CONFIG_BOARD_PARAM_FILE="/tmp/params"
CONFIG_BOARD_ROOT_PATH="/tmp"
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=y
CONFIG_PACKAGE_CORE=y
# CONFIG_MODULES_LOGGER is not set
CONFIG_PACKAGE_MULTICOPTER=y
CONFIG_MODULES_SIMULATION_PWM_OUT_SIM=y
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PERF=y
# CONFIG_SYSTEMCMDS_REBOOT is not set
CONFIG_SYSTEMCMDS_TOP=y
# CONFIG_SYSTEMCMDS_TUNE_CONTROL is not set
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
