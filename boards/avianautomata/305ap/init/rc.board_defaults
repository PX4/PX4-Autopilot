#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# Voltage divider 10k/1k = 1/11 ratio
param set-default BAT1_V_DIV 11.0

# No onboard current sensor
param set-default BAT1_A_PER_V 0

# Internal magnetometer present (MMC5983MA on I2C1)
param set-default SYS_HAS_MAG 1

# DShot output
param set-default PWM_MAIN_TIM0 -4

# Auto-detect RC protocol (UART5 SBUS)
param set-default RC_INPUT_PROTO -1

# No USB VBUS detection - bypass supply check
param set-default CBRK_SUPPLY_CHK 894281

# MSP OSD on VTX UART (USART2 → /dev/ttyS1 → TEL3)
param set-default MSP_OSD_CONFIG 103
param set-default SER_TEL3_BAUD 115200
