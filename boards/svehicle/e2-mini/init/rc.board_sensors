#!/bin/sh
#
# SVehicle E2-mini board sensor initialization
#------------------------------------------------------------------------------

if param compare -s ADC_ADS1115_EN 1
then
	ads1115 start -X
	board_adc start -n
else
	board_adc start
fi

if param compare SENS_EN_INA228 1
then
	# Start Digital power monitors
	ina228 -X start
fi

bmi088 -A -R 2 -s -b 3 start
bmi088 -G -R 2 -s -b 3 start

icm42688p -R 2 -s start

bmm150 -I -R 4 start

bmp388 -I -a 0x77 start
