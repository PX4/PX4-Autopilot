#!/bin/sh
#
# PX4 FMUv6U specific board sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI bus ICM-20602
mpu_direct -T icm20602 -R 12 -s start

# Internal SPI bus ICM-42605
icm42x -T icm42605 -R 14 -s start

# Internal SPI bus BMI088 accel/gyro
bmi_hybrid -T bmi088 -A -R 14 -s start
bmi_hybrid -T bmi088 -G -R 14 -s start

# internal compass
bmm150 -I -R 12 start

# internal baro
bmp388 -I start

# Baro on I2C3 (shared with a connector)
ms5611 -I -b 3 start
