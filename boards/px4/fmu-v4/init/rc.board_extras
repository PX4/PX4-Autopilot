#!/bin/sh
#
# PX4 FMUv4 specific board extras init
#------------------------------------------------------------------------------

# Run FrSky Telemetry on the dedicated FrSky port unless a SER_* port already runs it.
set FRSKY_ON_SER no
if param compare -s SER_TEL1_PROTO 21
then
	set FRSKY_ON_SER yes
fi
if param compare -s SER_TEL2_PROTO 21
then
	set FRSKY_ON_SER yes
fi
if param compare -s SER_WIFI_PROTO 21
then
	set FRSKY_ON_SER yes
fi
if param compare -s SER_GPS1_PROTO 21
then
	set FRSKY_ON_SER yes
fi
if param compare -s SER_RC_PROTO 21
then
	set FRSKY_ON_SER yes
fi
if [ $FRSKY_ON_SER = no ]
then
	frsky_telemetry start -d /dev/ttyS6 -t 15
fi
unset FRSKY_ON_SER
