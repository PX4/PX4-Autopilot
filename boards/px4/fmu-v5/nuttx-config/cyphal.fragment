CONFIG_CAN_EXTID=y
CONFIG_CAN_FIFOSIZE=32
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_STM32F7_CAN1=y
CONFIG_STM32F7_CAN1_BAUD=1000000
CONFIG_STM32F7_CAN_TSEG1=7
CONFIG_STM32F7_CAN_TSEG2=1
CONFIG_STM32F7_RTC_HSECLOCK=y
# CONFIG_EXAMPLES_CALIB_UDELAY is not set
# CONFIG_STM32F7_RTC_AUTO_LSECLOCK_START_DRV_CAPABILITY is not set
