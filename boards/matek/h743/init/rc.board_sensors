#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI bus ICM-42605
if ! mpu_direct -T mpu6000 -R 12 -b 1 -s start
then
	# Internal SPI bus ICM-42688P
	icm42x -T icm42688p -R 12 -b 1 -s start
fi

# internal SPI bus ICM-20602
if ! mpu_direct -T icm20602 -R 12 -b 4 -s start
then
	# Internal SPI bus ICM-42605
	icm42x -T icm42605 -R 14 -b 4 -s start
fi

# Internal baro
dps310 -I start -a 118

# External mag
qmc5883l -X start -a 13
