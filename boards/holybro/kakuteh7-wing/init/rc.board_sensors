#!/bin/sh
#
# PX4 FMUv6C specific board sensors init
#------------------------------------------------------------------------------
board_adc start

# Internal SPI IMU on SPI3 (same CS): ICM42688P or LSM6DSV
if ! icm42688p -R 2 -s -q start
then
	lsm6dsv -R 2 -s start
fi

# Internal baro
if ! bmp280 -I -b 4 -q start
then
	spa06 -I -b 4 start
fi

# MAX7456 OSD
if ! param compare OSD_ATXXXX_CFG 0
then
	atxxxx start -s
fi
