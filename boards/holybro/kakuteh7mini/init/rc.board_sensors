#!/bin/sh
#
# Holybro KakuteH7Mini specific board sensors init
#------------------------------------------------------------------------------
# v1.1=mpu6000   v1.3=bmi270   v1.5=icm42688p
board_adc start
if ! mpu6000 -R 6 -s -q start
then
  if ! bmi270 -R 6 -s -q start
  then
	icm42688p -R 6 -s start
  fi
fi

if ! bmp280 -I -b 1 start
then
	spa06 -I -b 1 start
fi
