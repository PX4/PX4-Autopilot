#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

param set-default BAT1_V_DIV 64.400000000

# CRSF receivers on the RC port work without further configuration
param set-default RC_CRSF_PRT_CFG 300

if param greater -s UAVCAN_ENABLE 0
then
	ifup can0
	ifup can1
fi
