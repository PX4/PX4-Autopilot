#!/bin/sh
#
# CyberX specific board sensors init
#------------------------------------------------------------------------------

# adc start
board_adc start

# Start Digital power monitors
ina228 -X -b 3 -a 0x40 start

# SPI1 gyro/accel
# ROTATION_ROLL_180
icm20689 -R 8 -s -b 1  start
# SPI3 gyro/accel
# ROTATION_PITCH_180
bmi088 -A -R 12 -s -b 3 start
bmi088 -G -R 12 -s -b 3 start
# SPI4 gyro/accel
# ROTATION_PITCH_180_YAW_90
icm42688p -R 26 -s -b 4 start

# SPI2 baro
bmp581 -s -b 2 start
# I2C4 baro
icp201xx -I -b 4 -a 0x63 start
#external baro
#icp201xx -X start

# I2C3 build-in magnetometer
ist8310 -I -b 3 -R 26 start

# External compass on GPS12/I2C12 (the external bus)
qmc5883l -X -b 1 start
qmc5883l -X -b 2 start
