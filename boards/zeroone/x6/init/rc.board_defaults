#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

if ver hwbasecmp 009 010 011
then
	# Skynode: use the "custom participant", IP=10.41.10.1 config for uxrce_dds_client
	param set-default UXRCE_DDS_PTCFG 2
	param set-default UXRCE_DDS_AG_IP 170461697
	param set-default UXRCE_DDS_ETH 1

	# SOM link is TELEM2 (ttyS4)
	param set-default SER_TEL2_PROTO 1
	param set-default SER_TEL2_BAUD 3000000
	param set-default MAV_1_MODE 11
	param set-default MAV_1_RATE 290000
	param set-default MAV_1_FLOW_CTRL 1
	param set-default MAV_1_RADIO_CTL 0
else
	# Mavlink ethernet
	param set-default MAV_ETH_EN 1
	param set-default MAV_1_MODE 0
fi

safety_button start

# pwm voltage 3.3V/5V switch
pwm_voltage_apply start
