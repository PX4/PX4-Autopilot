#!/bin/sh
#
# Atlas v6x board specific defaults
#------------------------------------------------------------------------------

# Disable all INA modules, not used on atlas
param set-default SENS_EN_INA238 0
param set-default SENS_EN_INA228 0
param set-default SENS_EN_INA226 0

# Mavlink mission computer (TELEM2)
param set-default MAV_1_CONFIG 102
param set-default MAV_1_MODE 0
param set-default SER_TEL2_BAUD 57600

# Mavlink ethernet (CFG 1000)
param set-default MAV_2_CONFIG 1000
param set-default MAV_2_BROADCAST 1
param set-default MAV_2_MODE 0
param set-default MAV_2_RADIO_CTL 0
param set-default MAV_2_RATE 100000
param set-default MAV_2_REMOTE_PRT 14550
param set-default MAV_2_UDP_PRT 14550

# Atlas: use the "custom participant", IP=10.41.10.1 config for uxrce_dds_client
param set-default UXRCE_DDS_PTCFG 2
param set-default UXRCE_DDS_AG_IP 170461697
param set-default UXRCE_DDS_CFG 1000

# Enable RPM measurement
param set-default SENS_EN_PCF8583 1

# Update default IP config if needed
netman update_default -i eth0

safety_button start
