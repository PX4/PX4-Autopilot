#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# Skynode: use the "custom participant", IP=10.41.10.1 config for uxrce_dds_client
param set-default UXRCE_DDS_PTCFG 2
param set-default UXRCE_DDS_AG_IP 170461697
param set-default UXRCE_DDS_ETH 1

# SOM link is TELEM2 (ttyS4)
param set-default SER_TEL2_PROTO 1
param set-default SER_TEL2_BAUD 3000000
param set-default MAV_1_MODE 11
param set-default MAV_1_RATE 290000
param set-default MAV_1_FLOW_CTRL 1

# IO owns SBUS/PPM/DSM; leave the FMU RC UART free for CRSF/GHST.
param set-default SER_RC_PROTO 0

# The buzzer draws too much power (0.2A) on the GPS power rail (limit 0.45A).
param set-default CBRK_BUZZER 782097

# Update default IP config if needed
netman update_default -i eth0

safety_button start

# GPIO Expander driver on external I2C3
if ver hwbasecmp 009 010 011
then
	# No USB
	mcp23009 start -b 3 -X -D 0xf0 -O 0xf0 -P 0x0f -M 0 -U 10
fi
if ver hwbasecmp 00a 008
then
	mcp23009 start -b 3 -X -D 0xf1 -O 0xf0 -P 0x0f -M 0 -U 10
fi
