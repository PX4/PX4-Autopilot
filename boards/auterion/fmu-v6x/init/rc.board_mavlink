#!/bin/sh
#
# Auterion FMUv6X specific board MAVLink startup script.
#------------------------------------------------------------------------------

if param compare MAV_SOM_FORWARD 1
then
	set S_FORWARD "-f"
else
	set S_FORWARD ""
fi

mavlink start -d /dev/ttyS4 -b 3000000 -r 290000 -m p:MAV_SOM_MODE -x -z $S_FORWARD

unset S_FORWARD
