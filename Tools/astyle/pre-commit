#!/usr/bin/env bash
#
# An example hook script to verify what is about to be committed.
# Called by "git commit" with no arguments. The hook should
# exit with non-zero status after issuing an appropriate message if
# it wants to stop the commit.
#
# To enable this hook, rename this file to "pre-commit".

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

# If you want to allow non-ascii filenames set this variable to true.
allownonascii=$(git config hooks.allownonascii)

# Redirect output to stderr.
exec 1>&2

# Cross platform projects tend to avoid non-ascii filenames; prevent
# them from being added to the repository. We exploit the fact that the
# printable range starts at the space character and ends with tilde.
if [ "$allownonascii" != "true" ] &&
	# Note that the use of brackets around a tr range is ok here, (it's
	# even required, for portability to Solaris 10's /usr/bin/tr), since
	# the square bracket bytes happen to fall in the designated range.
	test $(git diff --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	echo "Pre-commit style error: Attempt to add a non-ascii file name."
	echo
	echo "This can cause problems if you want to work"
	echo "with people on other platforms."
	echo
	echo "To be portable it is advisable to rename the file ..."
	echo
	echo "If you know what you are doing you can disable this"
	echo "check using:"
	echo
	echo "  git config hooks.allownonascii true"
	echo
	exit 1
fi

# If there are whitespace errors, print the offending file names and fail.
git diff-index --check --cached $against --
if [ $? -ne 0 ]; then
	echo "Pre-commit style error: Whitespace issues"
	exit 1
fi

# The following checks run on the staged content, exported into a temporary
# directory, so that unstaged changes neither hide nor cause errors.
REPO=$(git rev-parse --show-toplevel)
STAGED_DIR=$(mktemp -d)
trap 'rm -rf "$STAGED_DIR"' EXIT
git diff --cached --name-only --diff-filter=ACM -z | git checkout-index --stdin -z --prefix="$STAGED_DIR/"

# Check for missing or duplicate newlines at the end of changed text files
git diff --cached --name-only --diff-filter=ACM -z -- ':!docs/*' | xargs -0 -r git grep --cached -Il -z '' -- |
	(cd "$STAGED_DIR" && xargs -0 -r "$REPO/Tools/astyle/check_newlines.py")
if [ $? -ne 0 ]
then
	echo "Pre-commit style error: Missing or duplicate newlines at the end of files, fix with \"make format\" and stage the result"
	exit 1
fi

# Check for code style, only in changed files
comm -12 <(./Tools/astyle/files_to_check_code_style.sh | sort) <(git diff --cached --name-only --diff-filter=ACM | sort) |
	(cd "$STAGED_DIR" && xargs -r "$REPO/Tools/astyle/check_code_style.sh")
if [ $? -ne 0 ]
then
	echo "Pre-commit style error: Bad formatting according to astyle rules, fix with \"make format\" and stage the result"
	exit 1
fi
