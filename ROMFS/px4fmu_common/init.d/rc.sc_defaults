#!/bin/sh
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

set VEHICLE_TYPE spacecraft

# Set the airframe to the custom airframe
param set-default CA_AIRFRAME 14

# MAV_TYPE_SPACECRAFT_ORBITTER
param set-default MAV_TYPE 45

# Auto to be provided by Custom Airframe
param set-default CA_METHOD 0

# Set boot mode to manual
param set-default COM_FLTMODE_BOOT 0

# Disable auto-disarm before takeoff so external arming is not interrupted
param set-default COM_DISARM_PRFLT -1

# Relax arming checks: power supply, SD card hardfault and ESC telemetry
param set-default CBRK_SUPPLY_CHK 894281
param set-default COM_ARM_HFLT_CHK 0
param set-default COM_ARM_CHK_ESCS 0

# Manual control input: RC first, then MAVLink
param set-default COM_RC_IN_MODE 5

# Failsafes: disarm on manual control loss, otherwise warn or ignore
param set-default NAV_RCL_ACT 6
param set-default NAV_DLL_ACT 0
param set-default COM_LOW_BAT_ACT 0
param set-default COM_ACT_FAIL_ACT 0
param set-default GF_ACTION 0

# Expose CP_DIST to QGC (otherwise reported missing)
param set-default CP_DIST -1

# No barometer
param set-default SYS_HAS_BARO 0
param set-default EKF2_BARO_CTRL 0

# EKF2: fuse MoCap position, velocity and yaw, use it as height reference, no GNSS
param set-default EKF2_EV_CTRL 15
param set-default EKF2_EV_DELAY 5
param set-default EKF2_EVP_NOISE 0.001
param set-default EKF2_EVA_NOISE 0.002
param set-default EKF2_HGT_REF 3
param set-default EKF2_GPS_CTRL 0

# Disable IMU auto calibration from estimated biases
param set-default SENS_IMU_AUTOCAL 0
