// Regenerate: dot -Tsvg code_architecture.dot -o code_architecture.svg
digraph MissionRouteArchitecture {
    graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.45];
    node [shape=box, style="rounded,filled", color="#517394", fillcolor="#edf4fa", fontname="Arial", fontsize=13, margin="0.15,0.10"];
    edge [color="#61768a", fontname="Arial", fontsize=11];
    cache [label="Navigator / MissionRouteCache
Load mission and rally-point data"];
    view [label="MissionRouteProvider
Validated borrowed view"];
    mission_request [label="Mission activation
MIS_ROUTE_JOIN"];
    rtl [label="RTL selection / estimate refresh
RTL_TYPE=7"];
    planner [label="MissionRoutePlanner
Projection, direction and goal selection"];
    plan [label="Plan
Join, route, branch-off and goal"];
    fallback [label="RTL direct fallback", fillcolor="#fff3da"];
    join [label="MissionBase
Shared route join"];
    mission [label="Mission
Nominal traversal and actions"];
    follower [label="RtlMissionSafePointFollow
Route and destination stages"];
    estimate [label="Follower + RtlTimeEstimator
Remaining flown legs"];
    landing [label="MissionBase
Shared landing helpers"];
    output [label="MissionBlock
Reach checks, setpoints and commands"];
    control [label="Position and VTOL controllers", fillcolor="#e4f4e8"];
    cache -> view -> planner -> plan;
    mission_request -> planner;
    rtl -> planner;
    planner -> fallback [label="unavailable", style=dashed];
    plan -> join;
    plan -> estimate;
    join -> mission;
    join -> follower;
    mission -> landing;
    follower -> landing;
    mission -> output;
    follower -> output;
    landing -> output -> control;
    rtl -> follower [label="owns executor", style=dashed, constraint=false];
}
