/**
 * @file px4_mavlink_diagnostics.h
 *
 * Release stage of this build, and the compile-time diagnostics for MAVLink
 * definitions flagged in the XML, set per stage.
 *
 * cmake/px4_add_common_flags.cmake force-includes this header in every PX4
 * source, so the MAVLINK_* macros are defined before any MAVLink header is
 * included, however that header is reached.
 */

#pragma once

/** Release stage: "dev", "beta" or "release" (see cmake/px4_release_stage.cmake) */
#define PX4_RELEASE_STAGE "@PX4_RELEASE_STAGE@"

/** 1 if code guarded by PX4_MAVLINK_WIP() is compiled in (dev builds only). See mavlink_wip.h. */
#define PX4_MAVLINK_WIP_ENABLED @PX4_MAVLINK_WIP_ENABLED@

/** 1 if the uses in src/modules/mavlink/mavlink_wip_legacy.yaml may ship unguarded. */
#define PX4_MAVLINK_WIP_LEGACY_ENABLED @PX4_MAVLINK_WIP_LEGACY_ENABLED@

/**
 * Guard for a WIP MAV_CMD on the legacy list that PX4 handles by number
 * (VEHICLE_CMD_*): 1 unless the legacy list is switched off in a beta or
 * release build. Commands have no deprecation to waive, so this guard is what
 * removes them when the list is off. Tools/mavlink/check_wip.py checks that
 * <name> is on the list.
 */
#define PX4_MAVLINK_WIP_LEGACY(name) (PX4_MAVLINK_WIP_ENABLED || PX4_MAVLINK_WIP_LEGACY_ENABLED)

/*
 * The generated MAVLink headers tag WIP messages and enum entries with these
 * macros, which default to nothing. Where guarded WIP code is compiled out
 * (beta and release builds), any use left is unguarded, and -Werror makes
 * it fail to compile.
 */
#if !PX4_MAVLINK_WIP_ENABLED
#define MAVLINK_WIP      __attribute__((deprecated("MAVLink WIP item used outside a guard. Wrap it in '#if PX4_MAVLINK_WIP(<NAME>)' so it is excluded from releases. See the comment in mavlink_wip.h")))
#define MAVLINK_ENUM_WIP __attribute__((deprecated("MAVLink WIP item used outside a guard. Wrap it in '#if PX4_MAVLINK_WIP(<NAME>)' so it is excluded from releases. See the comment in mavlink_wip.h")))
#endif

/*
 * MAVLINK_DEPRECATED, MAVLINK_SUPERSEDED, MAVLINK_ENUM_DEPRECATED and
 * MAVLINK_ENUM_SUPERSEDED are not set yet, so they keep their no-op
 * defaults. They share -Wdeprecated-declarations with the WIP macros, so
 * they must stay unset in beta and release builds, where that warning is
 * an error.
 */
